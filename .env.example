# Required in development and production. No SQLite fallback exists.
# VIEWER_ENV=production requires sslmode=require, verify-ca, or verify-full.
# Production TLS example: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql+psycopg://ct_viewer:replace-me@127.0.0.1:5432/ct_viewer
VIEWER_ENV=development

APP_NAME=Chip Tournament Viewer
VIEWER_DB_POOL_SIZE=2
VIEWER_DB_MAX_OVERFLOW=1
VIEWER_DB_POOL_TIMEOUT=30
VIEWER_DB_POOL_RECYCLE=1800

# Test-only. Never point this at a non-test database.
VIEWER_POSTGRES_TEST_ENABLED=false
VIEWER_POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://ct_viewer_test:ct_viewer_test@127.0.0.1:55433/ct_viewer_test
